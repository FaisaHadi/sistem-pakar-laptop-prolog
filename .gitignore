# Daftar izin untuk paket sumber prototipe saat ini.
# Berkas baru diabaikan sampai jenis/path-nya diizinkan di bawah.
# Ini tidak menghapus berkas lokal atau berkas yang sudah tracked.
*
!/.gitignore
!/README.md
!/CONTRIBUTING.md

!/src/
!/src/main.pl
!/src/knowledge.pl
!/src/knowledge_meta.pl
!/src/knowledge_check.pl
!/src/explanation.pl
!/src/domain_validation.pl
!/src/web_app.pl

!/web/
!/web/index.html
!/web/styles.css
!/web/app.js
!/web/assets/
!/web/assets/gamaban-logo.svg
!/web/assets/gamaban-logo.png

!/tests/
!/tests/main_tests.pl
!/tests/web_tests.pl
!/tests/knowledge_tests.pl
!/tests/skenario_pengujian.md
!/tests/hasil_pengujian.md

!/knowledge/
!/knowledge/daftar_gejala.md
!/knowledge/aturan_diagnosa.md
!/knowledge/validasi_pakar.md
!/knowledge/kasus_validasi.json

!/docs/
!/docs/rancangan_awal.md
!/docs/referensi.md
!/docs/panduan_git.md
!/docs/persiapan_github.md
!/docs/materi/

!/presentation/
!/presentation/README.md
!/video/
!/video/README.md

# Direktori lokal, termasuk jika berada di dalam docs/.
.git/
.vscode/
.idea/
.codex/
.agents/
.aws/
.ssh/
node_modules/
__pycache__/
.venv/
venv/
tmp/
temp/
backup/
backups/
private/
local/
notes/
catatan_privat/
temp_*/
cache/
.cache/

# Materi asli dosen: hanya indeks README yang dibagikan via Git.
/docs/materi/**
!/docs/materi/README.md

# Metadata dan salinan editor yang kebetulan berekstensi Markdown.
.DS_Store
Thumbs.db
~$*
.#*
*.local.md
*.private.md

# Lapisan pengecualian tambahan; daftar izin tetap menjadi batas utama.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.zip
*.7z
*.rar
*.exe
*.msi
*.qlf
*.o
*.obj
*.log
*.tmp
*.bak
*.pyc
*.ppt
*.pptx
*.pdf
*.docx
*.mp4
*.mov
*.mkv
*.avi
*.webm
